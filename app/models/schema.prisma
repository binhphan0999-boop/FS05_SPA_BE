// ===== E-COMMERCE MODELS =====

model Category {
  id        String   @id() @default(uuid()) @map("id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  name String @map("name")
  slug String @unique @map("slug")

  // Relations
  products Product[]
  Service  Service[]

  @@map("categories")
}

model Product {
  id        String   @id() @default(uuid()) @map("id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  name        String  @map("name")
  slug        String  @unique @map("slug")
  description String? @map("description")
  content     String? @map("content")
  price       Float   @map("price")
  stock       Int     @default(0) @map("stock")
  sku         String  @unique @map("sku")
  categoryId  String  @map("category_id")
  status      String  @default("ACTIVE") @map("status") // ACTIVE, INACTIVE, ARCHIVED
  imgUrl      String? @map("img_url")

  // Relations
  category   Category    @relation(fields: [categoryId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("products")
}

model Cart {
  id        String   @id() @default(uuid()) @map("id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  userId String @map("user_id")

  // Relations
  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id() @default(uuid()) @map("id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  cartId    String @map("cart_id")
  productId String @map("product_id")
  quantity  Int    @map("quantity")

  // Relations
  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("cart_items")
}

model Order {
  id        String   @id() @default(uuid()) @map("id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  userId         String  @map("user_id")
  totalAmount    Float   @map("total_amount")
  status         String  @default("PENDING") @map("status") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  depositAmount  Float?  @map("deposit_amount")
  couponId       String? @map("coupon_id")
  discountAmount Float?  @map("discount_amount")

  deliveryAddress String? @map("delivery_address")
  deliveryPhone   String? @map("delivery_phone")
  deliveryNote    String? @map("delivery_note")

  // Relations
  user     User        @relation(fields: [userId], references: [id])
  coupon   Coupon?     @relation(fields: [couponId], references: [id])
  items    OrderItem[]
  payments Payment[]
  qrCodes  QRCode[]

  @@map("orders")
}

model OrderItem {
  id        String   @id() @default(uuid()) @map("id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  orderId   String @map("order_id")
  productId String @map("product_id")
  quantity  Int    @map("quantity")
  price     Float  @map("price")

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Payment {
  id        String   @id() @default(uuid()) @map("id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  orderId String  @map("order_id")
  amount  Float   @map("amount")
  method  String  @map("method") // CREDIT_CARD, BANK_TRANSFER, MOMO, ZALOPAY, COD
  type    String  @map("type") // FULL, DEPOSIT
  status  String  @default("PENDING") @map("status") // PENDING, PAID, FAILED, CANCELLED
  txnRef  String? @map("txn_ref")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model QRCode {
  id        String   @id() @default(uuid()) @map("id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  orderId   String    @map("order_id")
  code      String    @map("code")
  expiredAt DateTime? @map("expired_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("qr_codes")
}

model News {
  id        String  @id @default(uuid())
  title     String
  slug      String  @unique
  thumbnail String
  summary   String?
  content   String

  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id String @id @default(uuid())

  content String

  userName  String
  userEmail String?

  newsId String
  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model StaffSchedule {
  id        String    @id() @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")
  deleted   Boolean   @default(false) @map("deleted")

  staffId  String   @map("staff_id")
  workDate DateTime @map("work_date")

  startTime String @map("start_time")
  endTime   String @map("end_time")

  shiftType String? @map("shift_type")
  // MORNING
  // AFTERNOON
  // EVENING
  // FULL_TIME

  status String @default("ACTIVE") @map("status")
  // ACTIVE
  // OFF
  // LEAVE

  note String? @map("note")

  // Relations
  staff       User          @relation(fields: [staffId], references: [id])
  Service     Service?      @relation(fields: [serviceId], references: [id])
  serviceId   String?       @map("service_id")
  Appointment Appointment[]

  @@map("staff_schedules")
}

model Service {
  id              String  @id @default(uuid()) @map("id")
  name            String  @db.VarChar(255)
  description     String? @db.Text
  price           Decimal @db.Decimal(10, 2)
  durationMinutes Int     @map("duration_minutes")
  categoryId      String? @map("category_id")
  imageUrl        String? @map("image_url") @db.VarChar(500)
  isActive        Boolean @default(true) @map("is_active")
  isFeatured      Boolean @default(false) @map("is_featured")

  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  staffSchedules StaffSchedule[]
  Appointment    Appointment[]

  @@map("services")
}

