extends ../../layouts/admin/layout

block content
  - var FE_ORIGIN = 'http://localhost:3000'
  - var FALLBACK_IMG = '/images/img/user.png'
  - function resolveImg(url) { if (!url) return FALLBACK_IMG; if (/^https?:\/\//i.test(url)) return url; if (url.indexOf('/images/') === 0) return FE_ORIGIN + url; return url; }
  .container-fluid
    nav(aria-label="breadcrumb").breadcrumb-sticky
      ol.breadcrumb.mb-0
        li.breadcrumb-item
          a(href="/admin/news")
            i.fa.fa-newspaper-o.me-1
            | News Management
        li.breadcrumb-item
          a(href=`/admin/news/${article.id}`)= article.title
        li.breadcrumb-item.active(aria-current="page")= t('edit')

    form(method="post" action=`/admin/news/${article.id}?_method=PUT` enctype="multipart/form-data")
      .card.mb-4.content-card
        .card-header
          h6.mb-0.text-uppercase.text-primary.fw-bold Chỉnh sửa tin tức
        .card-body
          .row
            .col-md-4.text-center.mb-3
              .avatar-upload
                .avatar-preview.mb-2
                  img#imgPreview.img-thumbnail(src=resolveImg(article.thumbnail) onerror=`this.onerror=null;this.src='${FALLBACK_IMG}'` style="width: 180px; height: 180px; object-fit: cover; background:#f0f0f0")
                label.btn.btn-sm.btn-outline-primary.d-block
                  i.fa.fa-camera.me-1
                  | Đổi ảnh
                  input.d-none(type="file" name="image" accept="image/*" onchange="previewImage(this)")
                .small.text-muted.mt-2 Hoặc nhập URL ảnh bên dưới
                input.form-control.form-control-sm.mt-1(name="thumbnail" value=article.thumbnail || '' placeholder="/images/your-image.jpg")

            .col-md-8
              .row
                .col-md-12.mb-3
                  label.form-label Tiêu đề *
                  input.form-control(name="title" value=article.title required)

                .col-md-12.mb-3
                  label.form-label Mô tả ngắn
                  textarea.form-control(name="summary" rows="2")= article.summary || ''

                .col-md-12.mb-3
                  label.form-label Nội dung chi tiết *
                  textarea.form-control(name="content" rows="8" required)= article.content

      .d-flex.gap-2.mb-4
        button.btn.btn-primary(type="submit")
          i.fa.fa-save.me-1
          | Lưu thay đổi
        a.btn.btn-outline-secondary(href=`/admin/news/${article.id}`) Huỷ

  script.
    function previewImage(input) {
      if (input.files && input.files[0]) {
        var reader = new FileReader();
        reader.onload = function(e) {
          document.getElementById('imgPreview').src = e.target.result;
        }
        reader.readAsDataURL(input.files[0]);
      }
    }

    // Auto-submit the add comment form when user clicks outside
    document.addEventListener('DOMContentLoaded', function() {
      const addCommentForm = document.getElementById('addCommentForm');
      if (addCommentForm) {
        const submitBtn = addCommentForm.querySelector('button[type="submit"]');
        submitBtn.addEventListener('click', function(e) {
          // Form will submit normally
        });
      }
    });

