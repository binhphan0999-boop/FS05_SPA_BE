extends ../../layouts/admin/layout

block content
  .container-fluid
    nav(aria-label="breadcrumb").breadcrumb-sticky
      ol.breadcrumb.mb-0
        li.breadcrumb-item.active(aria-current="page") Appointment Management

    .table-block.mb-4
      .table-toolbar.d-flex.align-items-center.flex-wrap.gap-2.p-3.bg-light.rounded-top.border.border-bottom-0
        form.d-flex.align-items-center.flex-grow-1(method="get" action="/admin/appointments" style="min-width: 0")
          input(type="hidden" name="sortBy" value=sortBy)
          input(type="hidden" name="sortOrder" value=sortOrder)
          input(type="hidden" name="filterStatus" value=filterStatus)
          input(type="hidden" name="perPage" value=perPage)
          .input-group.input-group-sm.me-auto(style="max-width: 500px")
            input.form-control(type="search" name="search" placeholder="Search by Code, Name, Phone..." value=search)
            button.btn.btn-sm.btn-primary(type="submit" title=t('search'))
              i.fa.fa-search
          .d-flex.align-items-center.gap-2.ms-auto
            select.form-select.form-select-sm(name="filterStatus" style="min-width: 110px" onchange="this.form.submit()")
              option(value="")= t('admin.all_status')
              option(value="PENDING" selected=filterStatus==='PENDING') PENDING
              option(value="CONFIRMED" selected=filterStatus==='CONFIRMED') CONFIRMED
              option(value="CANCELED" selected=filterStatus==='CANCELED') CANCELED
              option(value="COMPLETED" selected=filterStatus==='COMPLETED') COMPLETED
            button.btn.btn-sm.btn-outline-secondary(type="button" onclick="location.reload()" title=t('refresh'))
              i.fa.fa-refresh
        button.btn.btn-sm.btn-primary(type="button" data-bs-toggle="modal" data-bs-target="#newAppointmentModal")
          i.fa.fa-plus.me-1
          | New Appointment
      .table-responsive.rounded-0
        table.table.table-hover.mb-0
          thead
            tr
              th
                a.text-decoration-none(href=buildSortUrl('appointmentCode')) Code
                if sortBy === 'appointmentCode'
                  i.fa.ms-1(class=sortOrder==='desc'?'fa-sort-desc':'fa-sort-asc' style="opacity:0.7")
              th
                a.text-decoration-none(href=buildSortUrl('customerName')) Customer
                if sortBy === 'customerName'
                  i.fa.ms-1(class=sortOrder==='desc'?'fa-sort-desc':'fa-sort-asc' style="opacity:0.7")
              th Phone
              th Staff
              th Service
              th
                a.text-decoration-none(href=buildSortUrl('appointmentDate')) Date
                if sortBy === 'appointmentDate'
                  i.fa.ms-1(class=sortOrder==='desc'?'fa-sort-desc':'fa-sort-asc' style="opacity:0.7")
              th Time
              th
                a.text-decoration-none(href=buildSortUrl('status')) Status
                if sortBy === 'status'
                  i.fa.ms-1(class=sortOrder==='desc'?'fa-sort-desc':'fa-sort-asc' style="opacity:0.7")
              th.text-center.table-actions= t('actions')
          tbody
            each a in appointments
              tr.table-row-clickable(role="button" tabindex="0" data-href=`/admin/appointments/${a.id}`)
                td.fw-bold= a.appointmentCode
                td= a.customerName
                td= a.customerPhone
                td= a.staffName || "-"
                td= a.serviceName || "-"
                td= a.appointmentDate
                td= `${a.startTime} - ${a.endTime}`
                td
                  span.badge(class=(a.status==='PENDING' ? 'bg-warning' : a.status==='CONFIRMED' ? 'bg-info' : a.status==='CANCELED' ? 'bg-danger' : 'bg-success'))= a.status
                td.text-center.table-actions(onclick="event.stopPropagation()")
                  form.d-inline(method="post" action=`/admin/appointments/${a.id}?_method=DELETE` onsubmit=`return confirm("Delete this appointment?")`)
                    button.btn.btn-sm.btn-link.text-danger.p-0(type="submit" title="Delete")
                      i.fa.fa-trash
      .table-footer.d-flex.justify-content-between.align-items-center.p-3.border-top.bg-light.rounded-bottom
        span.text-muted.small
          | Showing #{(page-1)*perPage+1}-#{Math.min(page*perPage, total)} of #{total} appointments
        .d-flex.align-items-center.gap-2
          form.d-inline(method="get" action="/admin/appointments")
            input(type="hidden" name="search" value=search)
            input(type="hidden" name="sortBy" value=sortBy)
            input(type="hidden" name="sortOrder" value=sortOrder)
            input(type="hidden" name="filterStatus" value=filterStatus)
            select.form-select.form-select-sm(name="perPage" style="min-width: 70px" onchange="this.form.submit()")
              option(value="10" selected=perPage===10) 10
              option(value="25" selected=perPage===25) 25
              option(value="50" selected=perPage===50) 50
            span.small.text-muted.ms-1= t('per_page')
          if total > perPage
            nav
              ul.pagination.pagination-sm.mb-0
                - const totalPages = Math.ceil(total / perPage)
                - const baseUrl = "/admin/appointments?page="
                - const qs = buildQueryString()
                li.page-item(class=page<=1?'disabled':'')
                  a.page-link(href=page<=1?'#':baseUrl+(page-1)+qs) &lsaquo;
                - for (let p = 1; p <= Math.min(totalPages, 10); p++)
                  li.page-item(class=p===page?'active':'')
                    a.page-link(href=baseUrl+p+qs)= p
                li.page-item(class=page>=totalPages?'disabled':'')
                  a.page-link(href=page>=totalPages?'#':baseUrl+(page+1)+qs) &rsaquo;

    #newAppointmentModal.modal.fade(tabindex="-1" aria-labelledby="newAppointmentModalLabel" aria-hidden="true")
      .modal-dialog.modal-lg
        .modal-content
          form(method="post" action="/admin/appointments")
            .modal-header
              h5#newAppointmentModalLabel.modal-title New Appointment
              button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
            .modal-body
              .row
                .col-md-6.mb-3
                  label.form-label Appointment Code
                  input.form-control(name="appointmentCode" required)
                .col-md-6.mb-3
                  label.form-label Customer Name
                  input.form-control(name="customerName" required)
                .col-md-6.mb-3
                  label.form-label Customer Phone
                  input.form-control(name="customerPhone" required)
                .col-md-6.mb-3
                  label.form-label Date
                  input.form-control(name="appointmentDate" type="date" required)
                .col-md-3.mb-3
                  label.form-label Start Time
                  input.form-control(name="startTime" type="time" required)
                .col-md-3.mb-3
                  label.form-label End Time
                  input.form-control(name="endTime" type="time" required)
                .col-md-6.mb-3
                  label.form-label Status
                  select.form-select(name="status" required)
                    option(value="PENDING") PENDING
                    option(value="CONFIRMED") CONFIRMED
                    option(value="CANCELED") CANCELED
                    option(value="COMPLETED") COMPLETED
            .modal-footer
              button.btn.btn-secondary(type="button" data-bs-dismiss="modal")= t('cancel')
              button.btn.btn-primary(type="submit")= t('create')

  script.
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.table-row-clickable').forEach(row => {
        row.addEventListener('click', () => { window.location.href = row.dataset.href; });
        row.addEventListener('keypress', (e) => { if (e.key === 'Enter') window.location.href = row.dataset.href; });
      });
    });