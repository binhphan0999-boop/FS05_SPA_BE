extends ../../layouts/admin/layout

block content
  .container-fluid
    nav(aria-label="breadcrumb").breadcrumb-sticky
      ol.breadcrumb.mb-0
        li.breadcrumb-item
          a(href="/admin/staff") Staff Management
        li.breadcrumb-item.active(aria-current="page") New Staff

    form(method="post" action="/admin/staff" enctype="multipart/form-data")
      .card.mb-4.content-card
        .card-header
          h6.mb-0.text-uppercase.text-primary.fw-bold New Staff Details
        .card-body
          .row
            .col-md-4.text-center.mb-3
              .avatar-upload
                .avatar-preview.mb-2
                  img#imgPreview.img-thumbnail.rounded-circle(src="/images/default-avatar.png" style="width: 150px; height: 150px; object-fit: cover;")
                label.btn.btn-sm.btn-outline-primary
                  i.fa.fa-camera.me-1
                  | Upload Avatar
                  input.d-none(type="file" name="avatar" accept="image/*" onchange="previewImage(this)")
            
            .col-md-8
              .row
                .col-md-6.mb-3
                  label.form-label= t('admin.first_name')
                  input.form-control(name="firstName" required)
                .col-md-6.mb-3
                  label.form-label= t('admin.last_name')
                  input.form-control(name="lastName" required)
                .col-md-6.mb-3
                  label.form-label= t('admin.email')
                  input.form-control(name="email" type="email" required)
                .col-md-6.mb-3
                  label.form-label= t('profile.phone')
                  input.form-control(name="phoneNumber")
                .col-md-6.mb-3
                  label.form-label Status
                  select.form-select(name="status" required)
                    option(value="ACTIVE") ACTIVE
                    option(value="INACTIVE") INACTIVE

      .d-flex.gap-2.mb-4
        button.btn.btn-primary(type="submit")
          i.fa.fa-save.me-1
          | Create Staff
        a.btn.btn-outline-secondary(href="/admin/staff") Cancel

  script.
    function previewImage(input) {
      if (input.files && input.files[0]) {
        var reader = new FileReader();
        reader.onload = function(e) {
          document.getElementById('imgPreview').src = e.target.result;
        }
        reader.readAsDataURL(input.files[0]);
      }
    }