extends ../../layouts/admin/layout

block content
  .container-fluid
    nav(aria-label="breadcrumb").breadcrumb-sticky
      ol.breadcrumb.mb-0
        li.breadcrumb-item
          a(href="/admin/customers") Customer Management
        li.breadcrumb-item.active(aria-current="page")= `${customer.firstName} ${customer.lastName}`

    .row
      .col-lg-8
        .card.mb-4.content-card
          .card-header.d-flex.justify-content-between.align-items-center
            h6.mb-0.text-uppercase.text-primary.fw-bold Customer Information
            .d-flex.gap-2
              a.btn.btn-sm.btn-warning(href=`/admin/customers/${customer.id}/edit`)
                i.fa.fa-edit.me-1
                = t('edit')
              form.d-inline(method="post" action=`/admin/customers/${customer.id}?_method=DELETE` onsubmit=`return confirm("Delete this customer?")`)
                button.btn.btn-sm.btn-danger(type="submit")
                  i.fa.fa-trash.me-1
                  = t('delete')
          .card-body
            .row
              .col-md-12.text-center.mb-4
                img.img-thumbnail.rounded-circle(src=customer.avatarUrl || "/images/default-avatar.png" style="width: 120px; height: 120px; object-fit: cover;")

              .col-md-6.mb-3
                label.text-muted.small= t('admin.first_name')
                p.mb-0.fw-semibold= customer.firstName
              .col-md-6.mb-3
                label.text-muted.small= t('admin.last_name')
                p.mb-0.fw-semibold= customer.lastName
              .col-md-6.mb-3
                label.text-muted.small Middle Name
                p.mb-0= customer.middleName || "-"
              .col-md-6.mb-3
                label.text-muted.small= t('admin.email')
                p.mb-0= customer.email || "-"
              .col-md-6.mb-3
                label.text-muted.small= t('profile.phone')
                p.mb-0= customer.phoneNumber || "-"
              .col-md-6.mb-3
                label.text-muted.small Gender
                p.mb-0= customer.gender || "-"
              .col-md-6.mb-3
                label.text-muted.small Birthday
                p.mb-0= customer.birthday ? new Date(customer.birthday).toLocaleDateString() : "-"
              .col-md-6.mb-3
                label.text-muted.small Status
                p.mb-0
                  span.badge(class=(customer.status==='ACTIVE' ? 'bg-success' : 'bg-secondary'))= customer.status
              .col-md-12.mb-3
                label.text-muted.small Address
                p.mb-0= customer.address || "-"
              .col-md-6.mb-3
                label.text-muted.small Created Date
                p.mb-0= customer.createdAt ? customer.createdAt.toLocaleDateString() : "-"

    .d-flex.gap-2.mb-4
      a.btn.btn-outline-secondary(href="/admin/customers")
        i.fa.fa-arrow-left.me-1
        | Back to List
