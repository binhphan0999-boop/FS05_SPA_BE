extends ../../layouts/admin/layout

block content
  - var FE_ORIGIN = 'http://localhost:3000'
  - var FALLBACK_IMG = '/images/img/user.png'
  - function resolveImg(url) { if (!url) return FALLBACK_IMG; if (/^https?:\/\//i.test(url)) return url; if (url.indexOf('/images/') === 0) return FE_ORIGIN + url; return url; }
  .container-fluid
    nav(aria-label="breadcrumb").breadcrumb-sticky
      ol.breadcrumb.mb-0
        li.breadcrumb-item.active(aria-current="page")
          i.fa.fa-box.me-1
          | Product Management

    .table-block.mb-4
      .table-toolbar.d-flex.align-items-center.flex-wrap.gap-2.p-3.bg-light.rounded-top.border.border-bottom-0
        form.d-flex.align-items-center.flex-grow-1(method="get" action="/admin/products" style="min-width: 0")
          input(type="hidden" name="sortBy" value=sortBy)
          input(type="hidden" name="sortOrder" value=sortOrder)
          input(type="hidden" name="perPage" value=perPage)
          .input-group.input-group-sm.me-auto(style="max-width: 500px")
            input#productSearchInput.form-control(type="search" name="search" placeholder="Tìm theo tên, SKU, mô tả..." value=search autocomplete="off")
            button.btn.btn-sm.btn-primary(type="submit" title=t('search'))
              i.fa.fa-search
          .d-flex.align-items-center.gap-2.ms-auto
            select.form-select.form-select-sm(name="filterCategory" style="min-width: 160px" onchange="this.form.submit()")
              option(value="") Tất cả danh mục
              each c in categories
                option(value=c.id selected=filterCategory===c.id)= c.name
            select.form-select.form-select-sm(name="filterStatus" style="min-width: 140px" onchange="this.form.submit()")
              option(value="") Tất cả trạng thái
              option(value="ACTIVE" selected=filterStatus==='ACTIVE') Đang hoạt động
              option(value="INACTIVE" selected=filterStatus==='INACTIVE') Vô hiệu hóa
              option(value="ARCHIVED" selected=filterStatus==='ARCHIVED') Lưu trữ
            button.btn.btn-sm.btn-outline-secondary(type="button" onclick="location.reload()" title=t('refresh'))
              i.fa.fa-refresh
        a.btn.btn-sm.btn-primary(href="/admin/products/new")
          i.fa.fa-plus.me-1
          | Thêm sản phẩm
      .table-responsive.rounded-0
        table.table.table-hover.mb-0
          thead
            tr
              th(style="width: 70px") Ảnh
              th
                a.text-decoration-none(href=buildSortUrl('name')) Tên sản phẩm
                if sortBy === 'name'
                  i.fa.ms-1(class=sortOrder==='desc'?'fa-sort-desc':'fa-sort-asc' style="opacity:0.7")
              th SKU
              th Danh mục
              th
                a.text-decoration-none(href=buildSortUrl('price')) Giá
                if sortBy === 'price'
                  i.fa.ms-1(class=sortOrder==='desc'?'fa-sort-desc':'fa-sort-asc' style="opacity:0.7")
              th
                a.text-decoration-none(href=buildSortUrl('stock')) Kho
                if sortBy === 'stock'
                  i.fa.ms-1(class=sortOrder==='desc'?'fa-sort-desc':'fa-sort-asc' style="opacity:0.7")
              th
                a.text-decoration-none(href=buildSortUrl('status')) Trạng thái
                if sortBy === 'status'
                  i.fa.ms-1(class=sortOrder==='desc'?'fa-sort-desc':'fa-sort-asc' style="opacity:0.7")
              th.text-center.table-actions= t('actions')
          tbody
            if products.length === 0
              tr
                td.text-center.text-muted.py-4(colspan="8") Chưa có sản phẩm nào
            each p in products
              tr.table-row-clickable(role="button" tabindex="0" data-href=`/admin/products/${p.id}`)
                td
                  img(src=resolveImg(p.imgUrl) onerror=`this.onerror=null;this.src='${FALLBACK_IMG}'` style="width:48px;height:48px;object-fit:cover;border-radius:4px;background:#f0f0f0")
                td
                  .fw-bold= p.name
                  if p.description
                    .small.text-muted.text-truncate(style="max-width:300px")= p.description
                td
                  code.bg-light.px-2.py-1= p.sku
                td= p.category ? p.category.name : "-"
                td
                  if p.price > 0
                    .fw-semibold.text-primary= Number(p.price).toLocaleString('vi-VN') + 'đ'
                  else
                    span.text-muted -
                td
                  if p.stock > 0
                    span.badge.bg-success= p.stock + ' cái'
                  else if p.stock === 0
                    span.badge.bg-warning.text-dark= 'Hết hàng'
                  else
                    span.badge.bg-danger= p.stock + ' cái'
                td
                  span.badge(class=(p.status==='ACTIVE'?'bg-success':p.status==='INACTIVE'?'bg-warning text-dark':'bg-secondary'))
                    if p.status === 'ACTIVE'
                      | Hoạt động
                    else if p.status === 'INACTIVE'
                      | Vô hiệu
                    else
                      | Lưu trữ
                td.text-center.table-actions(onclick="event.stopPropagation()")
                  a.btn.btn-sm.btn-link.text-warning.p-0.me-2(href=`/admin/products/${p.id}/edit` title="Edit")
                    i.fa.fa-edit
                  form.d-inline(method="post" action=`/admin/products/${p.id}?_method=DELETE` onsubmit=`return confirm("Lưu trữ sản phẩm này?")`)
                    button.btn.btn-sm.btn-link.text-danger.p-0(type="submit" title="Delete")
                      i.fa.fa-trash
      .table-footer.d-flex.justify-content-between.align-items-center.p-3.border-top.bg-light.rounded-bottom
        span.text-muted.small
          | Hiển thị #{total === 0 ? 0 : (page-1)*perPage+1}-#{Math.min(page*perPage, total)} / #{total} sản phẩm
        .d-flex.align-items-center.gap-2
          form.d-inline(method="get" action="/admin/products")
            input(type="hidden" name="search" value=search)
            input(type="hidden" name="sortBy" value=sortBy)
            input(type="hidden" name="sortOrder" value=sortOrder)
            input(type="hidden" name="filterStatus" value=filterStatus)
            input(type="hidden" name="filterCategory" value=filterCategory)
            select.form-select.form-select-sm(name="perPage" style="min-width: 70px" onchange="this.form.submit()")
              option(value="10" selected=perPage===10) 10
              option(value="25" selected=perPage===25) 25
              option(value="50" selected=perPage===50) 50
            span.small.text-muted.ms-1= t('per_page')
          if total > perPage
            nav(aria-label="Page navigation").ms-2
              ul.pagination.pagination-sm.mb-0
                li.page-item(class={disabled: page <= 1})
                  a.page-link(href=(page > 1 ? buildQueryString() + (buildQueryString() ? '&page=1' : '?page=1') : '#')) 
                    i.fa.fa-angle-double-left
                li.page-item(class={disabled: page <= 1})
                  a.page-link(href=(page > 1 ? `${buildQueryString()}${buildQueryString()?'&':'?'}page=${page-1}` : '#'))
                    i.fa.fa-angle-left
                - var startPage = Math.max(1, page - 2); var endPage = Math.min(Math.ceil(total/perPage), page + 2)
                if startPage > 1
                  li.page-item
                    a.page-link(href=`${buildQueryString()}${buildQueryString()?'&':'?'}page=1`) 1
                  if startPage > 2
                    li.page-item.disabled
                      span.page-link ...
                - for (var i = startPage; i <= endPage; i++)
                  li.page-item(class={active: i === page})
                    a.page-link(href=`${buildQueryString()}${buildQueryString()?'&':'?'}page=${i}`)= i
                - if (endPage < Math.ceil(total/perPage))
                  - if (endPage < Math.ceil(total/perPage) - 1)
                    li.page-item.disabled
                      span.page-link ...
                  li.page-item
                    a.page-link(href=`${buildQueryString()}${buildQueryString()?'&':'?'}page=${Math.ceil(total/perPage)}`)= Math.ceil(total/perPage)
                - var lastPage = Math.ceil(total/perPage)
                li.page-item(class={disabled: page >= lastPage})
                  a.page-link(href=(page < lastPage ? `${buildQueryString()}${buildQueryString()?'&':'?'}page=${page+1}` : '#'))
                    i.fa.fa-angle-right
                li.page-item(class={disabled: page >= lastPage})
                  a.page-link(href=(page < lastPage ? `${buildQueryString()}${buildQueryString()?'&':'?'}page=${lastPage}` : '#'))
                    i.fa.fa-angle-double-right
