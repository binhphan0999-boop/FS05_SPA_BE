//- app/views/admin/staffSchedule.view/index.pug
extends ../../layouts/admin/layout

block content
  .container-fluid
    nav(aria-label="breadcrumb").breadcrumb-sticky
      ol.breadcrumb.mb-0
        li.breadcrumb-item.active(aria-current="page") Staff Schedule Management

    .table-block.mb-4
      .table-toolbar.d-flex.align-items-center.flex-wrap.gap-2.p-3.bg-light.rounded-top.border.border-bottom-0
        form.d-flex.align-items-center.flex-grow-1(method="get" action="/admin/staff-schedules" style="min-width: 0")
          input(type="hidden" name="sortBy" value=sortBy)
          input(type="hidden" name="sortOrder" value=sortOrder)
          input(type="hidden" name="filterStatus" value=filterStatus)
          input(type="hidden" name="perPage" value=perPage)
          .input-group.input-group-sm.me-auto(style="max-width: 500px")
            input.form-control(type="search" name="search" placeholder="Search by Staff, Shift..." value=search)
            button.btn.btn-sm.btn-primary(type="submit")
              i.fa.fa-search
          .d-flex.align-items-center.gap-2.ms-auto
            select.form-select.form-select-sm(name="filterStatus" style="min-width: 110px" onchange="this.form.submit()")
              option(value="") All Status
              option(value="ACTIVE" selected=filterStatus==='ACTIVE') ACTIVE
              option(value="OFF" selected=filterStatus==='OFF') OFF
              option(value="LEAVE" selected=filterStatus==='LEAVE') LEAVE
            button.btn.btn-sm.btn-outline-secondary(type="button" onclick="location.reload()")
              i.fa.fa-refresh
        button.btn.btn-sm.btn-primary(type="button" data-bs-toggle="modal" data-bs-target="#newScheduleModal")
          i.fa.fa-plus.me-1
          | New Schedule
      .table-responsive.rounded-0
        table.table.table-hover.mb-0
          thead
            tr
              th Staff Name
              th
                a.text-decoration-none(href=buildSortUrl('workDate')) Work Date
                if sortBy === 'workDate'
                  i.fa.ms-1(class=sortOrder==='desc'?'fa-sort-desc':'fa-sort-asc' style="opacity:0.7")
              th Time
              th
                a.text-decoration-none(href=buildSortUrl('shiftType')) Shift Type
                if sortBy === 'shiftType'
                  i.fa.ms-1(class=sortOrder==='desc'?'fa-sort-desc':'fa-sort-asc' style="opacity:0.7")
              th
                a.text-decoration-none(href=buildSortUrl('status')) Status
                if sortBy === 'status'
                  i.fa.ms-1(class=sortOrder==='desc'?'fa-sort-desc':'fa-sort-asc' style="opacity:0.7")
              th Note
              th.text-center.table-actions Actions
          tbody
            each s in schedules
              tr.table-row-clickable(role="button" tabindex="0" data-href=`/admin/staff-schedules/${s.id}`)
                td.fw-bold= `${s.staff.firstName} ${s.staff.middleName || ''} ${s.staff.lastName}`
                td= s.workDate.toLocaleDateString('en-GB')
                td= `${s.startTime} - ${s.endTime}`
                td= s.shiftType
                td
                  span.badge(class=(s.status==='ACTIVE' ? 'bg-success' : s.status==='OFF' ? 'bg-danger' : 'bg-warning'))= s.status
                td.text-truncate(style="max-width: 150px")= s.note || "-"
                td.text-center.table-actions(onclick="event.stopPropagation()")
                  form.d-inline(method="post" action=`/admin/staff-schedules/${s.id}?_method=DELETE` onsubmit=`return confirm("Delete this schedule?")`)
                    button.btn.btn-sm.btn-link.text-danger.p-0(type="submit")
                      i.fa.fa-trash
      .table-footer.d-flex.justify-content-between.align-items-center.p-3.border-top.bg-light.rounded-bottom
        span.text-muted.small
          | Showing #{(page-1)*perPage+1}-#{Math.min(page*perPage, total)} of #{total} schedules
        .d-flex.align-items-center.gap-2
          form.d-inline(method="get" action="/admin/staff-schedules")
            input(type="hidden" name="search" value=search)
            input(type="hidden" name="sortBy" value=sortBy)
            input(type="hidden" name="sortOrder" value=sortOrder)
            input(type="hidden" name="filterStatus" value=filterStatus)
            select.form-select.form-select-sm(name="perPage" style="min-width: 70px" onchange="this.form.submit()")
              option(value="10" selected=perPage===10) 10
              option(value="25" selected=perPage===25) 25
              option(value="50" selected=perPage===50) 50
            span.small.text-muted.ms-1 items per page
          if total > perPage
            nav
              ul.pagination.pagination-sm.mb-0
                - const totalPages = Math.ceil(total / perPage)
                - const baseUrl = "/admin/staff-schedules?page="
                - const qs = buildQueryString()
                li.page-item(class=page<=1?'disabled':'')
                  a.page-link(href=page<=1?'#':baseUrl+(page-1)+qs) &lsaquo;
                - for (let p = 1; p <= Math.min(totalPages, 10); p++)
                  li.page-item(class=p===page?'active':'')
                    a.page-link(href=baseUrl+p+qs)= p
                li.page-item(class=page>=totalPages?'disabled':'')
                  a.page-link(href=page>=totalPages?'#':baseUrl+(page+1)+qs) &rsaquo;

    #newScheduleModal.modal.fade(tabindex="-1" aria-hidden="true")
      .modal-dialog.modal-lg
        .modal-content
          form(method="post" action="/admin/staff-schedules")
            .modal-header
              h5.modal-title New Staff Schedule
              button.btn-close(type="button" data-bs-dismiss="modal")
            .modal-body
              .row
                .col-md-6.mb-3
                  label.form-label Staff
                  select.form-select(name="staffId" required)
                    option(value="") Select Staff
                    each staff in (staffs || [])
                      option(value=staff.id)= `${staff.firstName} ${staff.middleName || ''} ${staff.lastName}`
                .col-md-6.mb-3
                  label.form-label Work Date
                  input.form-control(name="workDate" type="date" required)
                .col-md-3.mb-3
                  label.form-label Start Time
                  input.form-control(name="startTime" type="time" required)
                .col-md-3.mb-3
                  label.form-label End Time
                  input.form-control(name="endTime" type="time" required)
                .col-md-6.mb-3
                  label.form-label Shift Type
                  select.form-select(name="shiftType")
                    option(value="MORNING") MORNING
                    option(value="AFTERNOON") AFTERNOON
                    option(value="EVENING") EVENING
                    option(value="FULL_TIME") FULL_TIME
                .col-md-6.mb-3
                  label.form-label Status
                  select.form-select(name="status" required)
                    option(value="ACTIVE") ACTIVE
                    option(value="OFF") OFF
                    option(value="LEAVE") LEAVE
            .modal-footer
              button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancel
              button.btn.btn-primary(type="submit") Create

  script.
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.table-row-clickable').forEach(row => {
        row.addEventListener('click', () => { window.location.href = row.dataset.href; });
        row.addEventListener('keypress', (e) => { if (e.key === 'Enter') window.location.href = row.dataset.href; });
      });
    });
