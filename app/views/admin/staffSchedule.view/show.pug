//- app/views/admin/staffSchedule.view/show.pug
extends ../../layouts/admin/layout

block content
  .container-fluid
    nav(aria-label="breadcrumb").breadcrumb-sticky
      ol.breadcrumb.mb-0
        li.breadcrumb-item
          a(href="/admin/staff-schedules") Staff Schedule Management
        li.breadcrumb-item.active(aria-current="page") Schedule Detail

    .card.mb-4.content-card
      .card-header.d-flex.justify-content-between.align-items-center
        h6.mb-0.text-uppercase.text-primary.fw-bold Staff Schedule Info
        span.badge(class=(schedule.status==='ACTIVE' ? 'bg-success' : schedule.status==='OFF' ? 'bg-danger' : 'bg-warning'))= schedule.status
      .card-body
        .row.g-3
          .col-md-6
            label.text-muted.small.d-block Staff Name
            .fw-bold= `${schedule.staff.firstName} ${schedule.staff.middleName || ''} ${schedule.staff.lastName}`
          .col-md-6
            label.text-muted.small.d-block Work Date
            .fw-bold= schedule.workDate.toLocaleDateString('en-GB', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })
          .col-md-4
            label.text-muted.small.d-block Working Time
            .fw-bold= `${schedule.startTime} - ${schedule.endTime}`
          .col-md-4
            label.text-muted.small.d-block Shift Type
            .fw-bold= schedule.shiftType || "-"
          .col-md-4
            label.text-muted.small.d-block Created At
            .fw-bold= schedule.createdAt.toLocaleString()
          .col-12
            label.text-muted.small.d-block Note
            .p-2.bg-light.rounded= schedule.note || "No notes provided"

    .d-flex.gap-2.mb-4
      a.btn.btn-primary(href=`/admin/staff-schedules/${schedule.id}/edit`)
        i.fa.fa-edit.me-1
        | Edit
      form(method="post" action=`/admin/staff-schedules/${schedule.id}?_method=DELETE` onsubmit=`return confirm("Are you sure you want to delete this schedule?")`)
        button.btn.btn-danger(type="submit")
          i.fa.fa-trash.me-1
          | Delete
      a.btn.btn-outline-secondary(href="/admin/staff-schedules") Back to List
